# Use pnpm for package management
engine-strict=true
auto-install-peers=true
strict-peer-dependencies=false

# Performance optimizations
prefer-frozen-lockfile=true
ignore-scripts=false

# Registry configuration
registry=https://registry.npmjs.org/

# Logging
loglevel=warn

# React Native / Expo (apps/mobile)
# Metro and Expo autolinking expect a flat node_modules, so hoist everything
# to the workspace root. Same setup the mobile app ran with in walle-app.
shamefully-hoist=true
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=@react-native/*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=@react-navigation/*
public-hoist-pattern[]=nativewind
public-hoist-pattern[]=react-native-reanimated
public-hoist-pattern[]=react-native-safe-area-context
public-hoist-pattern[]=react-native-screens
public-hoist-pattern[]=metro-*
public-hoist-pattern[]=whatwg-*
public-hoist-pattern[]=webidl-conversions
public-hoist-pattern[]=punycode
public-hoist-pattern[]=semver

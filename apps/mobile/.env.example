# Mobile App Environment Variables
# Copy this file to .env and customize the values

# API Configuration
# One backend serves every tournament; requests name the selected tournament
# in the X-Tournament-Slug header. Tournaments come from its /api/tournaments.
EXPO_PUBLIC_API_BASE_URL=http://192.168.29.177:8000

# Debug Features
# Set to 'off' to disable the debug panel
EXPO_PUBLIC_DEBUG_PANEL=off

# Google Sign-In (Google Cloud Console > APIs & Services > Credentials)
# Web application client - must match the backend's GOOGLE_CLIENT_ID, since
# that's the audience the mobile app's native ID tokens are verified against.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client - only used for the native iOS sign-in handshake (also needed,
# reversed, as iosUrlScheme in app.json's google-signin plugin config)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=